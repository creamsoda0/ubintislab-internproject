<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ubintis.board.mapper.BoardMapper">

	<insert id="insertClip" parameterType="MainBoardVO" useGeneratedKeys="true" keyProperty="boardId">
        INSERT INTO mainboard (
            user_id,
            title,
            content,
            file_path,
            reg_date,
            mod_date
        ) VALUES (
            #{userId},   
            #{title},
            #{content},
            #{filePath}, 
            NOW(),       
            NOW()        
            )
    </insert>
    
    <select id="getClipList" resultType="MainBoardVO">
    SELECT *
    FROM mainboard
    ORDER BY board_id DESC        
    </select>

</mapper>